{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2023",
    // supabase-js's types name fetch and WebSocket types from the DOM lib,
    // though the seam-1 suite runs under Node.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "tests",
    "scripts",
    // The edge functions' bodies, which the seam-2 suite runs under Node.
    // Their Deno edges (supabase/functions/*/index.ts) are Deno's to check.
    "supabase/functions/_shared",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
