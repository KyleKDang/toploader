# Copy to .env.local, which Vite loads and git ignores.
# Every VITE_ variable ships to the browser, so only public values go here:
# never the database password or the secret (service-role) key.

# Local stack: the values `npx supabase status` prints after `npx supabase start`.
# Hosted project: https://kokkeqbbfmogfbmbafyz.supabase.co, and the publishable
# key from Project Settings > API Keys in the Supabase dashboard.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
